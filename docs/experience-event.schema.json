{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Documentation of the contract implemented by ai_sdlc/experience_events.py (EXPERIMENTAL). The runtime validator is hand-written stdlib Python, not driven by this file; tests assert the two agree on enums, required fields and examples. Closed schema: any field or enum change requires a new schema id (/2).",
  "title": "ai-sdlc-experience-event/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "event_id",
    "run_id",
    "seq",
    "type",
    "recorded_at",
    "subject",
    "actor",
    "observer",
    "method",
    "trust_level",
    "independence",
    "environment",
    "evidence",
    "data",
    "prev"
  ],
  "properties": {
    "schema": {
      "const": "ai-sdlc-experience-event/1"
    },
    "event_id": {
      "type": "string",
      "pattern": "^ev-[0-9a-f]{32}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5000
    },
    "type": {
      "enum": [
        "install.completed",
        "install.failed",
        "task.initialized",
        "task.approval_changed",
        "verify.completed",
        "check.operator_run",
        "human.feedback"
      ]
    },
    "recorded_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "task",
            "installation"
          ]
        },
        "task_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._+-]{1,64}$"
        },
        "repo_classification": {
          "enum": [
            "synthetic",
            "public-oss",
            "internal",
            "private"
          ]
        }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role"
      ],
      "properties": {
        "role": {
          "enum": [
            "agent",
            "operator",
            "human",
            "tool",
            "ci"
          ]
        },
        "name": {
          "enum": [
            "claude-code",
            "ai-sdlc-lite",
            "unknown"
          ]
        }
      }
    },
    "observer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role"
      ],
      "properties": {
        "role": {
          "enum": [
            "agent",
            "operator",
            "human",
            "tool",
            "ci"
          ]
        },
        "name": {
          "enum": [
            "claude-code",
            "ai-sdlc-lite",
            "unknown"
          ]
        }
      }
    },
    "method": {
      "enum": [
        "tool-observed-git-state",
        "tool-checked-hash",
        "tool-reported",
        "operator-ran",
        "operator-recorded",
        "human-decision-reported",
        "agent-reported",
        "ci-run",
        "unknown"
      ]
    },
    "trust_level": {
      "enum": [
        "T0",
        "T1",
        "T2",
        "H"
      ],
      "$comment": "T3 is not representable. H is representable but REJECTED by EXP-01 writers/validators (reason h_not_enabled) until decision D21 is approved; enabling it is a validator policy change, not a schema change."
    },
    "independence": {
      "enum": [
        "none",
        "same-actor-family",
        "separate-person",
        "ci-attested",
        "unknown"
      ],
      "$comment": "recorder CLAIM, never verified by Lite; ci-attested not emitted in EXP-01"
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "lite_version"
      ],
      "properties": {
        "platform": {
          "enum": [
            "linux",
            "macos",
            "windows",
            "unknown"
          ]
        },
        "lite_version": {
          "type": "string",
          "pattern": "^[0-9A-Za-z.+-]{1,32}$"
        },
        "bundle_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "lite_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "python": {
          "type": "string",
          "pattern": "^3\\.[0-9]{1,2}$"
        },
        "agent_name": {
          "enum": [
            "claude-code",
            "codex",
            "copilot",
            "none",
            "unknown"
          ]
        },
        "agent_version": {
          "type": "string",
          "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){0,3}$"
        },
        "mode": {
          "enum": [
            "noninteractive",
            "interactive",
            "unknown"
          ]
        }
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "ref"
        ],
        "properties": {
          "kind": {
            "enum": [
              "verification-report"
            ]
          },
          "ref": {
            "const": "none",
            "$comment": "paths are never stored in /1"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "data": {
      "type": "object",
      "$comment": "validated against data_by_type[type]"
    },
    "prev": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^ev-[0-9a-f]{32}$"
    }
  },
  "data_by_type": {
    "install.completed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "result",
        "file_count",
        "manifest_sha256"
      ],
      "properties": {
        "target": {
          "enum": [
            "agents",
            "claude-code"
          ]
        },
        "result": {
          "enum": [
            "INITIALIZED",
            "UNCHANGED",
            "CHECK_OK"
          ]
        },
        "file_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "install.failed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "reason_code",
        "partial"
      ],
      "properties": {
        "target": {
          "enum": [
            "agents",
            "claude-code"
          ]
        },
        "reason_code": {
          "enum": [
            "duplicate_manifest_key",
            "external_git_metadata",
            "framework_overlap",
            "framework_unavailable",
            "installation_content_conflict",
            "installation_inventory_conflict",
            "installation_missing",
            "installation_version_conflict",
            "invalid_git_root",
            "invalid_manifest",
            "inventory_limit",
            "oversized_file",
            "unsafe_file",
            "unsafe_path",
            "unsupported_filesystem_primitives",
            "validation_or_io_failure"
          ]
        },
        "partial": {
          "type": "boolean"
        }
      }
    },
    "task.initialized": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill_target",
        "context_written",
        "approval"
      ],
      "properties": {
        "skill_target": {
          "enum": [
            "agents",
            "claude-code"
          ]
        },
        "context_written": {
          "type": "boolean"
        },
        "approval": {
          "const": "PENDING"
        }
      }
    },
    "task.approval_changed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "task_revision"
      ],
      "properties": {
        "from": {
          "enum": [
            "PENDING",
            "APPROVED",
            "REVISED",
            "REJECTED"
          ]
        },
        "to": {
          "enum": [
            "PENDING",
            "APPROVED",
            "REVISED",
            "REJECTED"
          ]
        },
        "task_revision": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._+-]{1,64}$"
        }
      }
    },
    "verify.completed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "exit_code",
        "failure_reason_codes",
        "modified_path_count",
        "report_sha256",
        "registry_version",
        "facets",
        "checks_origin"
      ],
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "PARTIAL",
            "BLOCKED"
          ]
        },
        "exit_code": {
          "enum": [
            0,
            1,
            2
          ]
        },
        "failure_reason_codes": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "enum": [
              "baseline_mismatch",
              "baseline_record_mismatch",
              "check_failed",
              "declared_mismatch",
              "dirty_baseline",
              "evidence_hash_mismatch",
              "evidence_not_sealed",
              "evidence_tampered",
              "executable_git_config",
              "false_pass",
              "governance_path_modified_unapproved",
              "ignored_baseline_unknown",
              "ignored_listing_truncated",
              "ignored_path_unapproved",
              "incomplete_execution",
              "missing_evidence",
              "out_of_scope_modification",
              "protected_path_modified",
              "record_tampered",
              "required_check_missing",
              "special_file_change",
              "test_path_modified_unapproved",
              "verification_error"
            ]
          }
        },
        "modified_path_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "report_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "registry_version": {
          "const": 1
        },
        "facets": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "baseline",
            "hash_integrity",
            "custody",
            "independent_execution",
            "agent_assertions"
          ],
          "properties": {
            "baseline": {
              "enum": [
                "agent-reported",
                "operator-supplied-record"
              ]
            },
            "hash_integrity": {
              "enum": [
                "none",
                "partial",
                "all"
              ]
            },
            "custody": {
              "const": "unauthenticated"
            },
            "independent_execution": {
              "const": "not-verified"
            },
            "agent_assertions": {
              "const": "unverified"
            }
          }
        },
        "checks_origin": {
          "const": "agent-reported"
        }
      }
    },
    "check.operator_run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "exit_code",
        "outcome"
      ],
      "properties": {
        "check_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,31}$"
        },
        "exit_code": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "outcome": {
          "enum": [
            "pass",
            "fail",
            "error"
          ]
        },
        "tests_total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "tests_failed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        }
      }
    },
    "human.feedback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision"
      ],
      "properties": {
        "decision": {
          "enum": [
            "ACCEPTED",
            "REJECTED",
            "NEEDS_CHANGES",
            "NO_DECISION"
          ]
        },
        "friction": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "install",
              "discovery",
              "task-contract",
              "verification",
              "recovery",
              "docs",
              "other"
            ]
          }
        }
      }
    }
  },
  "x-method-ceilings": {
    "tool-observed-git-state": "T2",
    "tool-checked-hash": "T1",
    "tool-reported": "T0",
    "operator-ran": "T0",
    "operator-recorded": "T0",
    "human-decision-reported": "T0",
    "agent-reported": "T0",
    "ci-run": "T0",
    "unknown": "T0"
  },
  "x-type-rules": {
    "install.completed": {
      "methods": [
        "tool-checked-hash"
      ],
      "max_trust": "T1",
      "actor": "tool"
    },
    "install.failed": {
      "methods": [
        "tool-reported"
      ],
      "max_trust": "T0",
      "actor": "tool"
    },
    "task.initialized": {
      "methods": [
        "operator-recorded"
      ],
      "max_trust": "T0"
    },
    "task.approval_changed": {
      "methods": [
        "human-decision-reported"
      ],
      "max_trust": "T0"
    },
    "verify.completed": {
      "methods": [
        "tool-observed-git-state"
      ],
      "trust_level": "T2",
      "actor": "tool",
      "note": "primary claim = repository-state verdict; facets and checks_origin prevent reading PASS as executed checks"
    },
    "check.operator_run": {
      "methods": [
        "operator-ran"
      ],
      "trust_level": "T0",
      "independence": [
        "none",
        "same-actor-family",
        "separate-person",
        "unknown"
      ]
    },
    "human.feedback": {
      "methods": [
        "human-decision-reported"
      ],
      "max_trust": "T0",
      "independence": "none"
    }
  },
  "x-conformance-rules": [
    "seq starts at 1 and increases by 1; prev is the event_id of seq-1 (null at 1); run_id identical across the journal",
    "event_id = 'ev-' + first 32 hex of sha256(canonical JSON of the event without event_id)",
    "trust_level not above x-method-ceilings[method] and consistent with x-type-rules; T3 unrepresentable; H rejected (h_not_enabled)",
    "verify.completed: failure_reason_codes subset of the verifier registry (registry_version 1) and status consistent with codes",
    "an H event, when later enabled, never changes trust/independence of any other event",
    "journal limits: <= 4 MiB, <= 5000 events, one canonical-JSON line per event",
    "strings: no control, bidi, zero-width or surrogate characters; ASCII-escaped canonical form",
    "closed schema: unknown fields rejected; any field or enum change requires /2"
  ],
  "x-verifier-registry-snapshot": {
    "registry_version": 1,
    "codes": [
      "baseline_mismatch",
      "baseline_record_mismatch",
      "check_failed",
      "declared_mismatch",
      "dirty_baseline",
      "evidence_hash_mismatch",
      "evidence_not_sealed",
      "evidence_tampered",
      "executable_git_config",
      "false_pass",
      "governance_path_modified_unapproved",
      "ignored_baseline_unknown",
      "ignored_listing_truncated",
      "ignored_path_unapproved",
      "incomplete_execution",
      "missing_evidence",
      "out_of_scope_modification",
      "protected_path_modified",
      "record_tampered",
      "required_check_missing",
      "special_file_change",
      "test_path_modified_unapproved",
      "verification_error"
    ],
    "$comment": "informational; the validator loads the live registry and compares registry_version"
  },
