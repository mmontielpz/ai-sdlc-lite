{
  "name": "ai-sdlc-lite-website",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.8"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 127.0.0.1 --port 4321",
    "check:static": "node --test tests/static.test.mjs",
    "check:html": "html-validate \"dist/**/*.html\"",
    "check:browser": "playwright test",
    "check": "npm run build && npm run check:static && npm run check:html && npm run check:browser"
  },
  "dependencies": {
    "@astrojs/starlight": "0.43.2",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "astro": "7.4.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@playwright/test": "1.65.1",
    "html-validate": "11.23.0"
  }
}
