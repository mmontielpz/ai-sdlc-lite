---
import BoundsDiagram from './BoundsDiagram.astro';
import { doc, repoUrl } from '../lib/links.mjs';
import { version } from '../lib/canonical.mjs';

const lifecycle = [
  ['Bound', 'Agree scope and checks before work starts.'],
  ['Observe', 'Record what changed and what the checks returned.'],
  ['Verify', 'Compare the evidence with the agreement. Then decide.'],
];
const principles = [
  ['Minimum sufficient intelligence', 'The simplest mix of code, models, agents and people that does the job.'],
  ['Evidence over assertion', '“It passed” is a claim until someone checks it.'],
  ['Progressive autonomy', 'Delegate more as evidence accumulates. Today, work is human-supervised.'],
  ['Provider independence', 'Provider-neutral contracts. Verified agent support is narrower.'],
];
// Excerpt of `ai-sdlc verify` on examples/first-five-minutes; "…" marks omitted lines.
const output = [
  ['$ ai-sdlc verify --repo repo \\', 'command'],
  ['--result result.blocked.json \\', 'option'],
  ['--baseline-record baseline.json \\', 'option'],
  ['--format summary', 'option'],
  ['Status: BLOCKED (computed: BLOCKED, claimed: PASS)', 'status'],
  ['…', 'muted'],
  ['- [BLOCKED] out_of_scope_modification: src/greeter.py', 'reason'],
  ['- [BLOCKED] false_pass: contract claims PASS but verification computed BLOCKED', 'reason'],
  ['…', 'muted'],
];
---
<div class="home not-content">
  <section class="hero" aria-labelledby="_top">
    <p class="status"><span>Experimental</span> {version()} · no release published</p>
    <h1 id="_top">Engineer with agents. <em>Delegate with confidence.</em></h1>
    <p class="lead">An open methodology and lightweight reference framework for efficient, governed and verifiable agentic software engineering.</p>
    <p class="actions">
      <a class="button primary" href={doc('docs/QUICKSTART.md')}>Get started</a>
      <a class="button" href={repoUrl}>GitHub</a>
    </p>
  </section>

  <BoundsDiagram />

  <section aria-labelledby="lifecycle">
    <h2 id="lifecycle">One task. Two human gates.</h2>
    <ol class="lifecycle">
      {lifecycle.map(([name, text]) => (
        <li><h3>{name}</h3><p>{text}</p></li>
      ))}
    </ol>
  </section>

  <section class="split" aria-labelledby="principles">
    <h2 id="principles">Principles</h2>
    <dl>
      {principles.map(([name, text]) => (
        <div><dt>{name}</dt><dd>{text}</dd></div>
      ))}
    </dl>
  </section>

  <section class="split" aria-labelledby="example">
    <div>
      <h2 id="example">A claim is not proof.</h2>
      <p>The report says <code>PASS</code>. A file changed outside its scope.</p>
      <p><a href={doc('docs/QUICKSTART.md#4-run-the-bounded-example')}>Run this example</a></p>
    </div>
    <figure class="terminal">
      <pre><code>{output.map(([text, kind]) => <span class:list={['line', kind]}>{text}</span>)}</code></pre>
      <figcaption>Excerpt of real output from the repository’s bounded example.</figcaption>
    </figure>
  </section>
</div>
