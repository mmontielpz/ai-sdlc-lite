---
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import { nav } from '../lib/links.mjs';
---
<div class="site-header">
  <SiteTitle />
  <nav aria-label="Main">
    <ul>
      {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
    </ul>
  </nav>
</div>

<style>
  .site-header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; max-width: var(--sl-content-width); height: 100%; margin-inline: auto; }
  .site-header > :global(.site-title) { height: 1.75rem; }
  .site-header > :global(.site-title img) { width: auto; height: 1.5rem; }
  ul { display: flex; gap: clamp(1rem, 3vw, 2.25rem); margin: 0; padding: 0; list-style: none; }
  li { line-height: 1.4; }
  nav a { display: inline-block; padding: 0.3rem 0; color: var(--sl-color-gray-3); font-size: var(--sl-text-sm); font-weight: 500; text-decoration: none; }
  nav a:hover { color: var(--sl-color-white); }
</style>
